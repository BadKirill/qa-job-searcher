# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Strongly recommended: comma-separated Telegram numeric user IDs.
# Leave empty only if you intentionally want a public bot.
TELEGRAM_ALLOWED_USER_IDS=

SEARCH_PROFILE_PATH=config/search_profile.toml
JOB_BOARDS_PATH=config/job_boards.toml
TELEGRAM_CHANNELS_PATH=config/telegram_channels.toml
DATABASE_PATH=data/jobs.sqlite3
SEARCH_INTERVAL_MINUTES=180
HTTP_TIMEOUT_SECONDS=25
MAX_SEARCH_RESULTS=10
MAX_REVIEW_RESULTS=10
MAX_ALERTS_PER_RUN=8
LOG_LEVEL=INFO
