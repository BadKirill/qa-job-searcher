FROM node:22-bookworm-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=secret,id=proxy_ca sh -c 'if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; npm ci'
COPY frontend ./
COPY tests/fixtures/search-baseline.json /tests/fixtures/search-baseline.json
RUN npm run build

FROM python:3.12-slim-trixie
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 WEB_HOST=0.0.0.0 WEB_DATA_DIR=/app/data WEB_FRONTEND_DIR=/app/frontend/dist
WORKDIR /app
RUN --mount=type=secret,id=system_ca sh -c 'if [ -f /run/secrets/system_ca ]; then export SSL_CERT_FILE=/run/secrets/system_ca; fi; apt-get update && apt-get install -y --no-install-recommends postgresql-client-17 fonts-dejavu-core && rm -rf /var/lib/apt/lists/*'
COPY requirements.lock ./
RUN --mount=type=secret,id=system_ca sh -c 'if [ -f /run/secrets/system_ca ]; then export PIP_CERT=/run/secrets/system_ca; fi; pip install --no-cache-dir -r requirements.lock'
COPY pyproject.toml README.md ./
COPY src ./src
RUN --mount=type=secret,id=system_ca sh -c 'if [ -f /run/secrets/system_ca ]; then export PIP_CERT=/run/secrets/system_ca; fi; pip install --no-cache-dir --no-deps .'
COPY --from=frontend /frontend/dist ./frontend/dist
RUN groupadd -g 10001 job-searcher && useradd -u 10001 -g 10001 -M job-searcher && mkdir -p /app/data /backups && chown 10001:10001 /app/data /backups && chmod 700 /app/data /backups
USER 10001:10001
CMD ["qa-job-web"]
